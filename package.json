{
  "name": "secret-santa-generator",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizco/secret-santa-generator.git"
  },
  "bugs": {
    "url": "https://github.com/dizco/secret-santa-generator/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "test": "ng test",
    "test:coverage": "rimraf coverage && npm run test -- --coverage",
    "test:once": "npm run test:coverage -- --no-watch",
    "lint": "ng lint",
    "lint:fix": "ng lint ngx-admin-demo --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "e2e": "ng e2e",
    "e2e:ci": "npm run e2e -- --watch=false --headless=true --reporter junit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "~21.0.6",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@nebular/auth": "17.0.0",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/security": "17.0.0",
    "@nebular/theme": "17.0.0",
    "angular-auth-oidc-client": "^22.0.2",
    "bootstrap": "4.5.3",
    "eva-icons": "^1.1.3",
    "ionicons": "2.0.1",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "roboto-fontface": "0.8.0",
    "rxjs": "~7.8.1",
    "typeface-exo": "0.0.22",
    "zone.js": "~0.15.0",
    "ng-recaptcha-2": "21.0.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/language-service": "^21.2.0",
    "@compodoc/compodoc": "^1.1.11",
    "@cypress/schematic": "^2.5.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "21.4.0",
    "cypress": "13.3.3",
    "eslint": "^9.39.0",
    "jsdom": "^27.0.0",
    "rimraf": "^6.0.1",
    "stylelint": "^13.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
