{
  "name": "secret-santa-generator",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizco/secret-santa-generator.git"
  },
  "bugs": {
    "url": "https://github.com/dizco/secret-santa-generator/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "npm run build -- --configuration production --aot",
    "test": "ng test",
    "test:coverage": "rimraf coverage && npm run test -- --code-coverage",
    "test:once": "npm run test:coverage -- --no-watch --browsers Chrome_ci",
    "lint": "ng lint",
    "lint:fix": "ng lint ngx-admin-demo --fix",
    "lint:styles": "stylelint ./src/**/*.scss",
    "lint:ci": "npm run lint && npm run lint:styles",
    "e2e": "ng e2e",
    "e2e:ci": "npm run e2e -- --watch=false --headless=true --reporter junit",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@nebular/auth": "13.0.0",
    "@nebular/eva-icons": "13.0.0",
    "@nebular/security": "13.0.0",
    "@nebular/theme": "13.0.0",
    "angular-auth-oidc-client": "^15.0.5",
    "bootstrap": "4.5.3",
    "eva-icons": "^1.1.3",
    "ionicons": "2.0.1",
    "jasmine-reporters": "^2.3.2",
    "karma-junit-reporter": "^2.0.1",
    "ng-recaptcha": "^13.2.1",
    "normalize.css": "6.0.0",
    "pace-js": "1.0.2",
    "roboto-fontface": "0.8.0",
    "rxjs": "~7.8.1",
    "typeface-exo": "0.0.22",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular-eslint/builder": "17.5.3",
    "@angular-eslint/eslint-plugin": "17.5.3",
    "@angular-eslint/eslint-plugin-template": "17.5.3",
    "@angular-eslint/schematics": "17.5.3",
    "@angular-eslint/template-parser": "17.5.3",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/language-service": "17.3.12",
    "@compodoc/compodoc": "^1.1.11",
    "@cypress/schematic": "^2.5.1",
    "@types/jasmine": "~3.3.0",
    "@types/node": "^18.19.0",
    "cypress": "13.3.3",
    "jasmine-core": "~3.99.1",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.19",
    "karma-chrome-launcher": "~3.1.1",
    "karma-cli": "1.0.1",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.5.0",
    "mocha-junit-reporter": "^2.2.1",
    "rimraf": "2.6.1",
    "stylelint": "^13.7.2",
    "typescript": "~5.4.5"
  }
